<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_display" android:padding="8dp">
    <TextView android:id="@+id/tvDisplay" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="0" android:textColor="@color/text_white"
        android:textSize="48sp" android:gravity="end|bottom" android:padding="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btnClear" android:text="C" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_buttons" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnDivide" android:text="÷" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_operators" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnMultiply" android:text="×" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_operators" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnMinus" android:text="−" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_operators" android:textColor="@color/text_white"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btn7" android:text="7" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn8" android:text="8" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn9" android:text="9" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnPlus" android:text="+" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_operators" android:textColor="@color/text_white"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btn4" android:text="4" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn5" android:text="5" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn6" android:text="6" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnEquals" android:text="=" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_operators" android:textColor="@color/text_white"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btn1" android:text="1" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn2" android:text="2" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn3" android:text="3" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btn0" android:text="0" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="2" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btnDot" android:text="." android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:textSize="24sp" android:backgroundTint="@color/bg_numbers" android:textColor="@color/text_white"/>
    </LinearLayout>
</LinearLayout>
